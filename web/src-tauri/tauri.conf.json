{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nako",
  "version": "0.1.0-alpha.2",
  "identifier": "dev.nako.web",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "Nako",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
