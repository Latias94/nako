{
  "name": "@nako/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated TypeScript SDK for the Nako public client API.",
  "scripts": {
    "generate": "cargo run -q --manifest-path ../../Cargo.toml -p nako-api --example emit-typescript-sdk -- --output src/index.ts",
    "check": "tsc --noEmit",
    "verify": "npm run generate && npm run check"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
